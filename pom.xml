<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.github.nephets</groupId>
  <artifactId>glasshouse-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>llm-glasshouse</name>
  <description>Java AI 可观测与评测：OTel 原生链路追踪、Token 成本归因、Prompt 回归门禁</description>
  <url>https://github.com/nephets/llm-glasshouse</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>nephets</id>
      <name>llm-glasshouse contributors</name>
      <url>https://github.com/nephets</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/nephets/llm-glasshouse.git</connection>
    <developerConnection>scm:git:https://github.com/nephets/llm-glasshouse.git</developerConnection>
    <url>https://github.com/nephets/llm-glasshouse</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>glasshouse-core</module>
    <module>glasshouse-spring-boot-starter</module>
    <module>glasshouse-eval</module>
    <module>glasshouse-cli</module>
    <module>glasshouse-demo</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- ==== 三仓统一版本基线（架构 §1.1），改动必须三仓同 PR ==== -->
    <spring-ai.version>1.1.8</spring-ai.version>
    <opentelemetry.version>1.62.0</opentelemetry.version>
    <opentelemetry.instrumentation.version>2.28.1</opentelemetry.instrumentation.version>
    <!-- ★ GenAI 语义约定锁版本。1.42.0 起 GenAI 属性迁出主仓且仍在 development，
         改版本必须同步 docs/span-mapping.md 与 contract/contract-v1.json。 -->
    <opentelemetry.semconv.version>1.41.0</opentelemetry.semconv.version>
    <opentelemetry.semconv.incubating.version>1.41.0-alpha</opentelemetry.semconv.incubating.version>

    <!-- ==== 工具链 ==== -->
    <picocli.version>4.7.6</picocli.version>
    <assertj.version>3.27.3</assertj.version>
    <wiremock.version>3.13.2</wiremock.version>
    <jacoco.version>0.8.13</jacoco.version>
    <spotless.version>2.44.4</spotless.version>
    <google-java-format.version>1.25.2</google-java-format.version>
    <license.plugin.version>4.6</license.plugin.version>
    <dependency.plugin.version>3.8.1</dependency.plugin.version>

    <!-- ==== 覆盖率门禁（架构 §8.6） ==== -->
    <jacoco.core.minimum>0.80</jacoco.core.minimum>
    <jacoco.module.minimum>0.65</jacoco.module.minimum>
    <jacoco.total.minimum>0.60</jacoco.total.minimum>
    <!-- 由 CI 设置 -DskipITs=true 时跳过集成测试 -->
    <skipITs>false</skipITs>
    <!-- spotless 检查开关：-Pfast 时置true -->
    <spotless.check.skip>false</spotless.check.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-bom</artifactId>
        <version>${opentelemetry.instrumentation.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <!-- ★ groupId 是 info.picocli（架构文档 §7.1 写的 io.picocli 是笔误，
             中央仓库无该坐标），改动时不要"顺手改回" -->
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- 本仓模块 -->
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>glasshouse-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>glasshouse-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>glasshouse-eval</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>glasshouse-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      注意：这里刻意不放 spring-boot-starter-test。
      它会传递引入 spring-*，与 glasshouse-core 的「零 Spring 依赖」硬门禁冲突，
      而门禁规则检查的是依赖节点本身（exclusions 无法把节点从图里移除）。
      因此测试基线由各模块自行声明：
        - core    →裸 JUnit 5 + AssertJ（零 Spring）
        - 其余模块 → spring-boot-starter-test（需要 @SpringBootTest 等）
      AssertJ 是唯一全模块共用的测试依赖。
    -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
                <style>AOSP</style>
              </googleJavaFormat>
              <removeUnusedImports/>
              <importOrder>
                <order>java|javax,,io.github.nephets,org,com,\#</order>
              </importOrder>
            </java>
            <formats>
              <format>
                <includes>
                  <include>src/**/*.md</include>
                  <include>src/**/*.yml</include>
                  <include>src/**/*.yaml</include>
                  <include>src/**/*.json</include>
                  <include>src/**/*.jsonl</include>
                </includes>
                <!--
                  ★ src/test/resources/contract/contract-v1.json 是三仓契约的<b>字节级镜像</b>，
                  由 ContractSchemaTest 断言它与 contract/contract-v1.json 完全一致。
                  如果让 spotless 去「整理」它（换行符 / 行尾空白），两边就会漂移，
                  契约一致性测试随即失败 —— 所以这里必须排除掉它。
                  契约本体（contract/contract-v1.json）仍然走 spotless 校验。
                -->
                <excludes>
                  <exclude>src/test/resources/contract/contract-v1.json</exclude>
                </excludes>
                <trimTrailingWhitespace/>
                <endWithNewline/>
              </format>
            </formats>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.mycila</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${license.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <skip>${spotless.check.skip}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- ★ 必须显式引用 jacocoArgLine。prepare-agent 在 initialize 阶段把它写成
               ${jacocoArgLine} 属性；不引用它 surefire 就不会带 javaagent，
               结果是「测试全绿但 jacoco.exec 从未生成」——覆盖率门禁形同虚设。
               用 ${...} 而不是 @{...}：后者是晚绑定，会被 spring-boot-starter-parent
               预置的 argLine 抢先消费掉。 -->
          <argLine>${jacocoArgLine} -Dfile.encoding=UTF-8</argLine>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>${jacocoArgLine} -Dfile.encoding=UTF-8</argLine>
          <skipITs>${skipITs}</skipITs>
          <includes>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <!-- ★ 直接写进 surefire 的 argLine（而不是依赖 @{jacocoArgLine} 晚绑定）。
               晚绑定在有第二个 argLine 来源（Spring Boot parent 自带）时会被静默丢弃，
               结果是「测试全绿但 jacoco.exec 从未生成」——覆盖率门禁形同虚设且无人察觉。 -->
          <propertyName>jacocoArgLine</propertyName>
          <!--
            ★ 关于 destFile / dataFile：

            JaCoCo agent 在 Windows 上遇到含非 ASCII 字符（如中文）的路径会
            **静默失败**——不报错、不生成 .exec，只表现为 report/check 阶段打印
            「Skipping JaCoCo execution due to missing execution data file」。
            本仓的上级目录恰好含中文（程序宇宙），因此默认行为在本地会丢覆盖率数据。

            这里把 .exec 写到 ${project.build.directory}/jacoco/ 下（父目录会被
            maven-resources 自动创建），并在 CI（GitHub Actions，路径纯 ASCII）
            上同样有效。若你的仓库路径也不含 ASCII，可删掉这段配置。
            仍然丢数据时请先检查路径是否含中文，再用 -Djacoco.destFile=<ASCII路径> 兜底。
          -->
          <destFile>${project.build.directory}/jacoco/jacoco.exec</destFile>
          <dataFile>${project.build.directory}/jacoco/jacoco.exec</dataFile>
          <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
          <excludes>
            <exclude>**/*Configuration.class</exclude>
            <exclude>**/*Application.class</exclude>
            <exclude>**/package-info.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <phase>initialize</phase>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      覆盖率门禁按模块在各自 pom 中显式声明：
        glasshouse-core                             ≥ 80%
        starter / eval / cli / demo                 ≥ 65%
        全仓（.github/workflows/ci.yml 汇总）≥ 60%
      `-Pfast` 供本地快速迭代使用：跳过覆盖率、spotless 与集成测试。
    -->
    <profile>
      <id>fast</id>
      <properties>
        <skipITs>true</skipITs>
        <jacoco.skip>true</jacoco.skip>
        <spotless.check.skip>true</spotless.check.skip>
      </properties>
    </profile>
  </profiles>
</project>
