<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>glasshouse-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>glasshouse-cli</artifactId>
  <name>glasshouse-cli</name>
  <description>命令行入口：trace / cost / eval / prices 四个子命令，CI 回归门禁的主力</description>

  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>glasshouse-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>glasshouse-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>glasshouse-eval</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- CLI 需要 spring-core 的 Environment（推导模型供应商），但不启动 Spring 容器 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
    </dependency>
    <!-- SLF4J：日志约定要求「每次 LLM 调用一条结构化 INFO 日志」 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- 命令行运行时需要一个日志实现，否则 SLF4J 打印 "no providers found" 噪音 -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- 测试基线：需要 @SpringBootTest 等（父 pom 不统一下发，见父 pom 注释） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <resource>
        <!-- 构建版本号过滤：让版本子命令在任何运行方式下都正确 -->
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check-cli</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.module.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.github.nephets.glasshouse.cli.GlasshouseCli</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- 可执行 jar：CLI 是 CI 主力，必须能 java -jar 直接跑 -->
      <!--
        ★ 这里必须用 combine.self="override"。

        spring-boot-starter-parent 的 pluginManagement 里给 shade 预置了
        <filters> / <createDependencyReducedPom> 等配置，Maven 会把它与本模块配置「合并」。
        合并时父级的 <filters> 会插到 <transformers> 之前，导致 shade 在解析
        transformer 列表时把某个元素当成 resource 参数，最终报：

          Unable to parse configuration of mojo ...shade for parameter resource:
          Cannot find 'resource' in class ...ManifestResourceTransformer

        combine.self="override" 让本模块配置完全替换父级，而不是与之合并。
        这是本项目在 shade 3.3.0 ~ 3.6.2 上逐一实测确认的解法。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration combine.self="override">
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>cli</shadedClassifierName>
              <transformers>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.nephets.glasshouse.cli.GlasshouseCli</mainClass>
                </transformer>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer">
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
