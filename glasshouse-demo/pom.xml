<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>glasshouse-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>glasshouse-demo</artifactId>
  <name>glasshouse-demo</name>
  <description>一体化演示：mock-llm 假后端 + 三步客服 Agent + 多租户五维归因，开箱即得 span 树</description>

  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>glasshouse-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>glasshouse-eval</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>glasshouse-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- mock-llm 的流式 SSE 用 webflux（架构 §7.1：仅 mock-llm 模块） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>
    <!-- demo 的 ChatModel 用 Spring AI 的 OpenAI 兼容实现指向本进程内的 mock 服务。
         这也是「零侵入」的证明：业务侧用的是官方 starter，不含任何本仓埋点代码。 -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>

    <!-- 测试基线：需要 @SpringBootTest / MockMvc 等（父 pom 不统一下发，见父 pom 注释） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.github.nephets.glasshouse.demo.DemoApplication</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check-demo</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.module.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
